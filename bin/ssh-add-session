#!/bin/sh
# Load the work and personal SSH keys into the session agent if they are not
# already there. Plain ssh-add only picks up default names such as id_ed25519,
# so the keys are listed by path.
# GNOME autostart (Ubuntu login or VNC) uses zenity when DISPLAY is set;
# from a terminal, ssh-add prompts on the tty if askpass is unavailable.

if [ -z "${SSH_AUTH_SOCK:-}" ] && [ -n "${XDG_RUNTIME_DIR:-}" ]; then
  SSH_AUTH_SOCK="${XDG_RUNTIME_DIR}/openssh_agent"
  export SSH_AUTH_SOCK
fi

if [ -z "${SSH_AUTH_SOCK:-}" ] || [ ! -S "$SSH_AUTH_SOCK" ]; then
  exit 0
fi

rc=0
loaded=$(ssh-add -l 2>/dev/null) || rc=$?
# 0 = identities loaded, 1 = reachable but empty, 2 = cannot connect
[ "$rc" -eq 2 ] && exit 0

set --
for key in "$HOME/.ssh/id_ed25519_work" "$HOME/.ssh/id_ed25519_personal"; do
  [ -f "$key" ] || continue
  fp=$(ssh-keygen -lf "$key" 2>/dev/null | awk '{print $2}')
  if [ -n "$fp" ]; then
    case "$loaded" in *"$fp"*) continue ;; esac
  fi
  set -- "$@" "$key"
done
[ "$#" -eq 0 ] && exit 0

ASKPASS="${HOME}/.local/bin/ssh-askpass-zenity"
if [ -x "$ASKPASS" ] && [ -n "${DISPLAY:-}" ]; then
  SSH_ASKPASS="$ASKPASS"
  SSH_ASKPASS_REQUIRE=force
  export SSH_ASKPASS SSH_ASKPASS_REQUIRE
  exec ssh-add "$@" </dev/null
fi
exec ssh-add "$@"
